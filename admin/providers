@app.route('/admin/provider/<int:provider_id>')
@admin_required
def view_provider(provider_id):
    conn = sqlite3.connect('payments.db')
    c = conn.cursor()
    
    c.execute("""SELECT p.*, u.username, u.email, u.created_at as user_created
               FROM providers p 
               JOIN users u ON p.user_id = u.id
               WHERE p.id=?""", (provider_id,))
    provider = c.fetchone()
    
    if not provider:
        conn.close()
        return "Provider not found", 404
    
    # Payments
    c.execute("""SELECT * FROM payments WHERE provider_id=? 
               ORDER BY id DESC LIMIT 50""", (provider_id,))
    payments = c.fetchall()
    
    # Stats
    c.execute("SELECT COUNT(*) FROM payments WHERE provider_id=?", (provider_id,))
    total_payments = c.fetchone()[0]
    
    c.execute("SELECT SUM(amount) FROM payments WHERE provider_id=?", (provider_id,))
    total_received = c.fetchone()[0] or 0
    
    conn.close()
    
    return render_template_string('''
